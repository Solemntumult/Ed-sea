generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Candidat {
  id             String       @id @default(uuid())
  nom            String
  prenom         String
  email          String       @unique
  telephone      String?
  dateNaissance  DateTime?
  candidatures   Candidature[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model Specialite {
  id             String       @id @default(uuid())
  nom            String
  departement    String       // ex: CIPMA, FDCA, IMSP
  candidatures   Candidature[]
}

model Candidature {
  id                String      @id @default(uuid())
  candidatId        String
  specialiteId      String
  moyenneMaster     Float
  statut            StatutDossier @default(BROUILLON)
  filiereOrigine    String
  
  // Relations
  candidat          Candidat    @relation(fields: [candidatId], references: [id])
  specialite        Specialite  @relation(fields: [specialiteId], references: [id])
  
  // Documents (chemins ou URLs)
  quittanceCucaUrl  String?
  memoireMasterUrl  String?
  ficheRenseignementsUrl String?
  
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
}

enum StatutDossier {
  BROUILLON
  SOUMIS
  EN_ATTENTE_PIECE
  ELIGIBLE
  REJETE
  VALIDE_CUCA
}
